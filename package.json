{
  "name": "cennik-konwersji-lamp-i-multimediow",
  "private": true,
  "version": "1.0.0",
  "description": "Cennik konwersji lamp i multimediów",
  "author": "AutoLamp Studio",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "electron:dev": "concurrently -k \"tsx server.ts\" \"wait-on tcp:3000 && electron .\"",
    "build:installer": "npm run build && npx electron-builder --win nsis --x64 --ia32",
    "build:installer:x64": "npm run build && npx electron-builder --win nsis --x64",
    "build:installer:x32": "npm run build && npx electron-builder --win nsis --ia32",
    "build:exe": "npm run build && npx electron-builder --win nsis --x64 --ia32",
    "build:portable": "npm run build && npx electron-builder --win portable --x64 --ia32",
    "build:portable:x64": "npm run build && npx electron-builder --win portable --x64",
    "build:portable:x32": "npm run build && npx electron-builder --win portable --ia32",
    "build:all": "npm run build && npx electron-builder --win nsis portable --x64 --ia32"
  },
  "build": {
    "appId": "com.katalog.lampy",
    "productName": "Cennik konwersji lamp i multimediów",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cennik konwersji lamp i multimediów",
      "uninstallDisplayName": "Cennik konwersji lamp i multimediów (Odinstaluj)",
      "artifactName": "${productName}-Setup-${arch}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "Polish",
        "English"
      ],
      "language": "1045"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  }
}
