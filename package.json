    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
